---
import { getCollection } from "astro:content";
import Section from "../Section.astro";
import StackList from "../StackList.astro";
import Icon from "../Icon.astro";
import { formatPeriod } from "../../lib/format";

const roles = (await getCollection("experience", ({ data }) => !data.parent)).sort((a, b) => a.data.order - b.data.order);
---

<Section id="experience" title="Experience" index="02">
  <ol class="relative">
    {
      roles.map(({ id, data }) => (
        <li class="relative grid gap-x-10 gap-y-3 pb-16 last:pb-0 md:grid-cols-[13rem_1fr]">
          <div class="text-text-muted text-lg md:pt-1.5">
            <p class="text-text">{formatPeriod(data.period)}</p>
            <p>
              {data.employment} · {data.location}
            </p>
          </div>

          <div class="relative border-l border-text-muted/50 pl-6 sm:pl-10">
            <span class="absolute -left-[5px] top-3 size-2.5 rounded-full bg-text" aria-hidden="true" />
            <h3 class="text-2xl sm:text-3xl">
              {data.role}
              <span class="text-text-muted">
                @{" "}
                {data.companyUrl ? (
                  <a href={data.companyUrl} target="_blank" rel="noopener">
                    {data.company}
                  </a>
                ) : (
                  data.company
                )}
              </span>
            </h3>

            {data.stats && <p class="mt-1 text-lg text-text-muted">{data.stats}</p>}
            {data.summary && <p class="mt-3 max-w-3xl text-lg sm:text-xl font-light">{data.summary}</p>}

            {data.highlights.length > 0 && (
              <ul class="mt-4 max-w-3xl space-y-2 text-lg font-light">
                {data.highlights.map((item) => (
                  <li class="relative pl-6 before:absolute before:left-0 before:top-[0.85em] before:h-px before:w-3 before:bg-text-muted">
                    {item}
                  </li>
                ))}
              </ul>
            )}

            {data.projects.length > 0 && (
              <div class="mt-6 max-w-3xl divide-y divide-text-muted/30 border-y border-text-muted/30">
                {data.projects.map((project) => (
                  <details class="group">
                    <summary class="flex cursor-pointer list-none items-baseline gap-4 py-3 [&::-webkit-details-marker]:hidden">
                      <span class="text-xl">{project.title}</span>
                      {project.period && <span class="text-text-muted">{project.period}</span>}
                      <span class="ml-auto self-center">
                        <Icon name="mdi-light:chevron-up" size={24} class="rotate-180 transition-transform group-open:rotate-0" />
                      </span>
                    </summary>
                    <div class="space-y-3 pb-5">
                      <p class="text-lg font-light">{project.summary}</p>
                      <ul class="space-y-1.5 text-lg font-light">
                        {project.highlights.map((item) => (
                          <li class="relative pl-6 before:absolute before:left-0 before:top-[0.85em] before:h-px before:w-3 before:bg-text-muted">
                            {item}
                          </li>
                        ))}
                      </ul>
                      {project.stack.length > 0 && <StackList items={project.stack} size="sm" />}
                    </div>
                  </details>
                ))}
              </div>
            )}

            {data.quotes.length > 0 && (
              <div class="mt-6 grid max-w-3xl gap-4 sm:grid-cols-2">
                {data.quotes.slice(0, 2).map((quote) => (
                  <blockquote class="border-l-2 border-text-muted/50 pl-4 text-lg font-light italic">
                    “{quote}”
                    <footer class="mt-1 text-sm not-italic text-text-muted">Client review</footer>
                  </blockquote>
                ))}
              </div>
            )}

            <div class="mt-6">
              <StackList items={data.stack} />
            </div>

            {data.caseStudy && (
              <a href={`/experience/${id}/`} class="mt-6 inline-block text-lg">
                Read the case study →
              </a>
            )}
          </div>
        </li>
      ))
    }
  </ol>
</Section>
