---
import { getCollection } from "astro:content";
import Section from "../Section.astro";
import { EDUCATION } from "../../data/education";
import { byStartDesc, formatPeriod, startYear, PROJECT_KIND_LABELS, type Period } from "../../lib/format";

interface Item {
  title: string;
  kind: string;
  period: Period;
  href: string;
}

const roles = await getCollection("experience", ({ data }) => !data.parent);
const projects = await getCollection("projects");

const items: Item[] = [
  ...roles.map(({ data }) => ({
    title: `${data.role} @ ${data.company}`,
    kind: "Work",
    period: data.period,
    href: "#experience",
  })),
  ...projects.map(({ id, data }) => ({
    title: data.title,
    kind: PROJECT_KIND_LABELS[data.kind],
    period: data.period,
    href: `#project-${id}`,
  })),
  ...EDUCATION.map((edu) => ({
    title: `${edu.degree}, STU FIIT`,
    kind: "Education",
    period: edu.period,
    href: "#education",
  })),
].sort(byStartDesc((item: Item) => item.period));

const years = [...new Set(items.map((item) => startYear(item.period)))];
---

<Section id="timeline" title="Timeline" index="04">
  <ol class="max-w-4xl">
    {
      years.map((year) => (
        <li class="grid gap-x-10 border-t border-text-muted/30 py-6 sm:grid-cols-[8rem_1fr]">
          <p class="skranji-regular text-3xl text-text-muted">{year}</p>
          <ul class="space-y-3">
            {items
              .filter((item) => startYear(item.period) === year)
              .map((item) => (
                <li class="flex flex-wrap items-baseline gap-x-4 gap-y-0.5">
                  <a href={item.href} class="text-xl">
                    {item.title}
                  </a>
                  <span class="text-sm uppercase tracking-widest text-text-muted">{item.kind}</span>
                  <span class="text-base text-text-muted sm:ml-auto">{formatPeriod(item.period)}</span>
                </li>
              ))}
          </ul>
        </li>
      ))
    }
  </ol>
</Section>
