---
import Section from "../Section.astro";
import { SKILLS, SPOKEN_LANGUAGES } from "../../data/skills";
---

<Section id="skills" title="Skills" index="05">
  <dl class="grid gap-x-12 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
    {
      SKILLS.map((group) => (
        <div class="border-t border-text-muted/50 pt-4">
          <dt class="mb-3 text-sm uppercase tracking-widest text-text-muted">{group.label}</dt>
          <dd>
            <ul class="flex flex-wrap gap-x-4 gap-y-1 text-xl font-light">
              {group.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </dd>
        </div>
      ))
    }
    <div class="border-t border-text-muted/50 pt-4">
      <dt class="mb-3 text-sm uppercase tracking-widest text-text-muted">Spoken languages</dt>
      <dd>
        <ul class="flex flex-wrap gap-x-4 gap-y-1 text-xl font-light">
          {
            SPOKEN_LANGUAGES.map((lang) => (
              <li>
                {lang.name} <span class="text-text-muted">{lang.level}</span>
              </li>
            ))
          }
        </ul>
      </dd>
    </div>
  </dl>
</Section>
