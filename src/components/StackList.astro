---
interface Props {
  items: readonly string[];
  label?: string;
  size?: "sm" | "md";
}

const { items, label = "Tech stack", size = "md" } = Astro.props;
---

<ul class="flex flex-wrap gap-2" aria-label={label}>
  {
    items.map((item) => (
      <li
        class:list={[
          "border border-text-muted/50 text-text-muted tracking-wide",
          size === "sm" ? "px-1.5 text-xs" : "px-2 py-0.5 text-sm",
        ]}
      >
        {item}
      </li>
    ))
  }
</ul>
