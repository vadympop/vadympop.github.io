---
import Icon from "./Icon.astro";
import CVButton from "./CVButton.astro";
import { PROFILE } from "../data/profile";
---

<section class="page-section relative" aria-label="Introduction">
  <div class="md:pt-40 pt-30">
    <p class="hero-line skranji-regular text-5xl sm:text-7xl" style="--i: 0">Hi,</p>
    <h1 class="hero-line skranji-regular text-5xl sm:text-7xl my-3 sm:my-5" style="--i: 1">I'm {PROFILE.firstName}</h1>
    <p class="hero-line skranji-regular text-2xl sm:text-4xl" style="--i: 2">{PROFILE.position}</p>
    <div class="hero-line skranji-regular text-text-muted flex items-center text-lg sm:text-2xl my-1 sm:my-3" style="--i: 3">
      <Icon name="mdi:location" size={28} />
      <span>{PROFILE.location}</span>
    </div>
    <ul class="hero-line main-stack flex flex-wrap text-lg sm:text-3xl mb-6" style="--i: 4" aria-label="Main stack">
      {PROFILE.briefStack.map((tech) => <li class="mr-2 sm:mr-5">{tech}</li>)}
    </ul>
    <div class="hero-line" style="--i: 5"><CVButton /></div>
  </div>
</section>
