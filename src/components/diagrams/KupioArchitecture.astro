<svg viewBox="0 0 960 530" role="img" aria-labelledby="kupio-diagram-title">
  <title id="kupio-diagram-title">
    Kupio architecture: the mobile app talks to the FastAPI backend over REST and WebSocket. The backend uses PostgreSQL, Redis,
    AWS S3 and Stripe, and hands push notifications to a background worker that sends them through Firebase Cloud Messaging.
  </title>
  <defs>
    <marker id="kupio-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0,0 L10,5 L0,10 z" fill="currentColor"></path>
    </marker>
  </defs>

  <!-- Left column: clients and push -->
  <rect class="d-box" x="20" y="40" width="190" height="110" rx="2"></rect>
  <text class="d-title" x="115" y="80" text-anchor="middle">Mobile app</text>
  <text class="d-text" x="115" y="105" text-anchor="middle">Kotlin Multiplatform</text>
  <text class="d-text" x="115" y="127" text-anchor="middle">Android · iOS</text>

  <rect class="d-box" x="20" y="260" width="190" height="80" rx="2"></rect>
  <text class="d-title" x="115" y="295" text-anchor="middle">Firebase FCM</text>
  <text class="d-text" x="115" y="320" text-anchor="middle">push delivery</text>

  <!-- Center: API -->
  <rect class="d-box" x="330" y="20" width="300" height="380" rx="2"></rect>
  <text class="d-title" x="480" y="47" text-anchor="middle">FastAPI backend</text>
  <text class="d-text" x="480" y="62" text-anchor="middle" dy="2">11 domain modules</text>

  <rect class="d-box-muted" x="350" y="76" width="260" height="38"></rect>
  <text class="d-text" x="480" y="100" text-anchor="middle">REST routers · Pydantic schemas</text>
  <rect class="d-box-muted" x="350" y="128" width="260" height="38"></rect>
  <text class="d-text" x="480" y="152" text-anchor="middle">Services + Unit of Work</text>
  <rect class="d-box-muted" x="350" y="180" width="260" height="38"></rect>
  <text class="d-text" x="480" y="204" text-anchor="middle">Repositories · async SQLAlchemy 2</text>

  <rect class="d-box-muted" x="350" y="300" width="260" height="44"></rect>
  <text class="d-text" x="480" y="319" text-anchor="middle">WebSocket chat handler</text>
  <text class="d-text" x="480" y="336" text-anchor="middle">auth · typing · read receipts · replay</text>

  <!-- Bottom center: worker -->
  <rect class="d-box" x="330" y="440" width="300" height="70" rx="2"></rect>
  <text class="d-title" x="480" y="469" text-anchor="middle">Background worker</text>
  <text class="d-text" x="480" y="492" text-anchor="middle">FCM push · promotion expiry cron</text>

  <!-- Right column: infrastructure -->
  <rect class="d-box" x="750" y="20" width="190" height="70" rx="2"></rect>
  <text class="d-title" x="845" y="50" text-anchor="middle">PostgreSQL</text>
  <text class="d-text" x="845" y="72" text-anchor="middle">listings · chat · sessions</text>

  <rect class="d-box" x="750" y="120" width="190" height="90" rx="2"></rect>
  <text class="d-title" x="845" y="150" text-anchor="middle">Redis</text>
  <text class="d-text" x="845" y="172" text-anchor="middle">chat pub/sub · presence</text>
  <text class="d-text" x="845" y="192" text-anchor="middle">task queue</text>

  <rect class="d-box" x="750" y="240" width="190" height="64" rx="2"></rect>
  <text class="d-title" x="845" y="268" text-anchor="middle">AWS S3</text>
  <text class="d-text" x="845" y="290" text-anchor="middle">listing images</text>

  <rect class="d-box" x="750" y="332" width="190" height="64" rx="2"></rect>
  <text class="d-title" x="845" y="360" text-anchor="middle">Stripe</text>
  <text class="d-text" x="845" y="382" text-anchor="middle">Checkout · webhooks</text>

  <!-- Edges -->
  <path class="d-edge" d="M210 95 H350" marker-end="url(#kupio-arrow)"></path>
  <text class="d-label" x="272" y="87" text-anchor="middle">REST · JWT</text>

  <path class="d-edge" d="M210 132 H290 V322 H350" marker-start="url(#kupio-arrow)" marker-end="url(#kupio-arrow)"></path>
  <text class="d-label" x="290" y="232" text-anchor="middle">WebSocket</text>

  <path class="d-edge" d="M630 55 H750" marker-end="url(#kupio-arrow)"></path>
  <path class="d-edge" d="M630 165 H750" marker-start="url(#kupio-arrow)" marker-end="url(#kupio-arrow)"></path>
  <path class="d-edge" d="M630 272 H750" marker-end="url(#kupio-arrow)"></path>
  <path class="d-edge" d="M630 364 H750" marker-start="url(#kupio-arrow)" marker-end="url(#kupio-arrow)"></path>

  <path class="d-edge" d="M480 400 V440" marker-end="url(#kupio-arrow)"></path>
  <text class="d-label" x="535" y="425" text-anchor="middle">enqueue push</text>

  <path class="d-edge" d="M330 475 H250 V300 H210" marker-end="url(#kupio-arrow)"></path>
  <text class="d-label" x="250" y="400" text-anchor="middle">send</text>

  <path class="d-edge-dashed" d="M115 260 V150" marker-end="url(#kupio-arrow)"></path>
  <text class="d-label" x="115" y="210" text-anchor="middle">push</text>
</svg>
