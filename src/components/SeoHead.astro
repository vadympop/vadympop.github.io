---
/**
 * Search and social metadata: title, description, canonical URL, robots, Open Graph, Twitter card and optional JSON-LD.
 */
import { PROFILE } from "../data/profile";

export interface SeoProps {
  title: string;
  description: string;
  /** Keep the page out of search results (it stays reachable by link) */
  noindex?: boolean;
  ogType?: "website" | "profile" | "article";
  /** Absolute or root-relative image URL, 1200×630 */
  image?: string;
  imageAlt?: string;
  /** Structured data objects, rendered as application/ld+json */
  jsonLd?: Record<string, unknown>[];
}

type Props = SeoProps;

const {
  title,
  description,
  noindex = false,
  ogType = "website",
  image = "/og.png",
  imageAlt = `${PROFILE.fullName}, ${PROFILE.position}`,
  jsonLd = [],
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
<meta name="author" content={PROFILE.fullName} />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={PROFILE.fullName} />
<meta property="og:locale" content="en_US" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={imageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={imageAlt} />
{
  ogType === "profile" && (
    <>
      <meta property="profile:first_name" content={PROFILE.firstName} />
      <meta property="profile:last_name" content={PROFILE.fullName.split(" ").slice(1).join(" ")} />
    </>
  )
}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={imageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

{jsonLd.map((data) => <script type="application/ld+json" is:inline set:html={JSON.stringify(data)} />)}
